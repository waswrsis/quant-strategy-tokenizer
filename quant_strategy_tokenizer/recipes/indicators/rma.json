{
  "recipe": "indicator.rma",
  "version": 1,
  "params_schema": {
    "alpha": {"type": "number", "minimum": 0, "maximum": 1},
    "init": {
      "oneOf": [
        {"type": "number"},
        {"type": "string", "enum": ["first_value"]}
      ],
      "default": "first_value"
    }
  },
  "inputs": {
    "series": "TimeSeries[float]"
  },
  "outputs": {
    "value": "rma.value"
  },
  "graph": [
    {
      "id": "rma",
      "token": "smooth.linear_recursive",
      "v": 1,
      "params": {
        "alpha": "$params.alpha",
        "init": "$params.init"
      },
      "inputs": {
        "series": "$inputs.series"
      }
    }
  ],
  "description": "Recursive moving average accepting alpha and init only in P0."
}
