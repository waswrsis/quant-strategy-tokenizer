{
  "recipe": "indicator.ewm",
  "version": 1,
  "params_schema": {
    "span": {"type": "integer", "minimum": 1},
    "init": {
      "oneOf": [
        {"type": "number"},
        {"type": "string", "enum": ["first_value"]}
      ],
      "default": "first_value"
    }
  },
  "inputs": {
    "series": "TimeSeries[float]"
  },
  "outputs": {
    "value": "ewm.value"
  },
  "graph": [
    {
      "id": "ewm",
      "token": "smooth.linear_recursive",
      "v": 1,
      "params": {
        "alpha": "$compute:2/($params.span+1)",
        "init": "$params.init"
      },
      "inputs": {
        "series": "$inputs.series"
      }
    }
  ],
  "description": "Exponential moving average via linear recursive smoothing."
}
