{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QST P2a-2 Recipe Generator",
  "type": "object",
  "required": ["recipe"],
  "additionalProperties": false,
  "properties": {
    "recipe": {
      "type": "object",
      "required": ["id", "version", "inputs", "outputs", "generator"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "integer", "minimum": 1},
        "params_schema": {"type": "object"},
        "inputs": {"type": "object", "additionalProperties": {"type": "string"}},
        "outputs": {"type": "object", "additionalProperties": {"type": "string"}},
        "description": {"type": "string"},
        "generator": {
          "type": "object",
          "required": ["emit"],
          "additionalProperties": false,
          "properties": {
            "emit": {
              "type": "array",
              "items": {"$ref": "#/$defs/generatorNode"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "generatorNode": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {"type": "string"},
        "token": {"type": "string"},
        "recipe": {"type": "string"},
        "v": {"type": "integer"},
        "version": {"type": "integer"},
        "params": {"type": "object"},
        "inputs": {"type": "object"},
        "role": {"type": "string"},
        "static_for": {"type": "object"},
        "body": {"type": "array", "items": {"$ref": "#/$defs/generatorNode"}},
        "static_if": {},
        "then": {"type": "array", "items": {"$ref": "#/$defs/generatorNode"}},
        "else": {"type": "array", "items": {"$ref": "#/$defs/generatorNode"}},
        "include": {"type": "string"}
      }
    }
  }
}
