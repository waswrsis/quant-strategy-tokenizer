{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qst.local/schemas/tagspec.schema.json",
  "title": "QST TagSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "semantic_id",
    "version",
    "domain",
    "source_recipe",
    "source_recipe_version",
    "graph_template_hash"
  ],
  "properties": {
    "semantic_id": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "domain": {
      "type": "string"
    },
    "params_schema": {
      "type": "object"
    },
    "source_recipe": {
      "type": "string"
    },
    "source_recipe_version": {
      "type": "integer",
      "minimum": 1
    },
    "graph_template_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tag_attached_by_trusted": {"type": "boolean"},
        "graph_template_hash_valid": {"type": "boolean"},
        "namespace_allowed": {"type": "boolean"},
        "contracts_pass": {"type": ["boolean", "null"]},
        "fuzzing_at_ci_standard": {"type": ["boolean", "null"]},
        "metamorphic_pass": {"type": ["boolean", "null"]}
      }
    },
    "reference_impl": {
      "type": ["string", "null"]
    },
    "contract_suite": {
      "type": ["string", "null"]
    },
    "fuzzing_report": {
      "type": ["string", "null"]
    },
    "metamorphic_properties": {
      "type": "array",
      "items": {"type": "string"}
    },
    "allowed_kernels": {
      "type": "array",
      "items": {"type": "object"}
    },
    "lifecycle": {
      "type": "string",
      "enum": ["experimental", "core_candidate", "core_stable", "deprecated"]
    },
    "owner": {
      "type": ["string", "null"]
    }
  }
}
