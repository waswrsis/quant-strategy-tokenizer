{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qst.local/schema/envelope.schema.json",
  "title": "QST Deployment Envelope",
  "type": "object",
  "required": ["strategy_instance_hash", "profile"],
  "properties": {
    "strategy_instance_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "profile": {"enum": ["research", "paper", "pretrade", "production_guarded"]},
    "approved_by": {"type": ["string", "null"]},
    "approved_at": {"type": ["string", "null"], "format": "date-time"},
    "validation_result_hash": {"type": ["string", "null"]},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
