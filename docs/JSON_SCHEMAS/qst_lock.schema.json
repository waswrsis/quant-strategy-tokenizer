{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qst.local/schemas/qst_lock.schema.json",
  "title": "QST P3a-0 Lock File",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lock_version",
    "qst_version",
    "qst_version_policy",
    "ir_version",
    "canonical_version",
    "strategy",
    "strategy_version",
    "strategy_hashes",
    "canonical_ir_hash",
    "externals",
    "tokens",
    "recipes",
    "tagspecs",
    "fixtures"
  ],
  "properties": {
    "lock_version": {"const": "qst-lock/0.1"},
    "qst_version": {"type": "string"},
    "qst_version_policy": {"type": "string", "enum": ["strict", "same_minor"]},
    "ir_version": {"const": "qst-ir/0.3"},
    "canonical_version": {"const": "qst-canonical/0.1"},
    "strategy": {"type": "string"},
    "strategy_version": {"type": "integer"},
    "strategy_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graph_hash", "param_hash", "instance_hash"],
      "properties": {
        "graph_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "param_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "instance_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "canonical_ir_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "externals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_hash"],
      "properties": {
        "schema_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "behavior_version"],
        "properties": {
          "id": {"type": "string"},
          "version": {"type": "integer", "minimum": 1},
          "behavior_version": {"type": "integer", "minimum": 1}
        }
      }
    },
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["recipe", "version"],
        "properties": {
          "recipe": {"type": "string"},
          "version": {"type": "integer", "minimum": 1}
        }
      }
    },
    "tagspecs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "semantic_id",
          "version",
          "graph_template_hash",
          "verification_state",
          "allowed_kernels"
        ],
        "properties": {
          "semantic_id": {"type": "string"},
          "version": {"type": "integer", "minimum": 1},
          "graph_template_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "verification_state": {
            "type": "string",
            "enum": ["unverified", "minimally_attached", "fully_verified"]
          },
          "allowed_kernels": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "fixtures": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "market_csv_hash": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "expected_trace_hash": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "trace_semantic_hash": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
