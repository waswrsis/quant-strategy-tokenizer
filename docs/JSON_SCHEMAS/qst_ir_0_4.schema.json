{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qst.local/schemas/qst_ir_0_4.schema.json",
  "title": "QST IR 0.4 Minimal Shell",
  "type": "object",
  "additionalProperties": false,
  "required": ["ir_version", "canonical_version", "strategy", "metadata"],
  "properties": {
    "ir_version": {
      "const": "qst-ir/0.4"
    },
    "canonical_version": {
      "const": "qst-canonical/0.4"
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "nodes", "outputs"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "inputs", "params", "metadata"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "token": {
                "type": ["string", "null"]
              },
              "version": {
                "type": ["integer", "null"],
                "minimum": 1
              },
              "inputs": {
                "type": "object"
              },
              "params": {
                "type": "object"
              },
              "metadata": {
                "type": "object"
              }
            }
          }
        },
        "outputs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "metadata": {
      "type": "object"
    }
  }
}
