{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qst.local/schema/token.schema.json",
  "title": "QST TokenSpec",
  "type": "object",
  "required": ["id", "version", "layer", "category", "inputs", "outputs", "temporal", "failure_policy"],
  "properties": {
    "id": {"type": "string"},
    "version": {"type": "integer"},
    "behavior_version": {"type": "integer"},
    "layer": {"enum": ["computation", "infrastructure"]},
    "category": {"type": "string"},
    "inputs": {"type": "object"},
    "outputs": {"type": "object"},
    "params_schema": {"type": "object"},
    "behavior_contract": {"type": "array"}
  },
  "additionalProperties": true
}
